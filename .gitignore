# Public plugin source, documentation and supported user tooling.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/[Rr][Ee][Aa][Dd][Mm][Ee]*
!/[Dd]oxyfile*
!/.[Dd]oxyfile*
!/zh.md
!/Docs
!/skills
!/Scripts
!/*.uplugin
!/Source/
!/Config/
!/Content/
!/Resources/
!/Shaders/

# Generated files and caches are never project inputs.
**/Binaries/
**/Intermediate/
**/Saved/
**/DerivedDataCache/
**/__pycache__/
**/.pytest_cache/
**/.vs/
*.pyc
*.pyo
*.log
*.bak
*.codex-bak-*
